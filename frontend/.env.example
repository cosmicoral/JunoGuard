# Leave all unset to run in mock mode (the default — works with no backend).
#
# Data source precedence (docs/api-contract.md):
#   Supabase (if VITE_SUPABASE_URL) > SSE (if VITE_API_URL) > mock

# Required for Google sign-in and Supabase Realtime. The anon key is safe to
# expose in Vite; database access is enforced by RLS and the user's JWT.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Gateway base URL. Enables the SSE live feed and the kill switch
# (POST /v1/projects/suspend · /v1/projects/resume).
# VITE_API_URL=http://localhost:8000
