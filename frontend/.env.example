# Leave all unset to run in mock mode (the default — works with no backend).
#
# Data source precedence (docs/api-contract.md):
#   Supabase (if VITE_SUPABASE_URL) > SSE (if VITE_API_URL) > mock

# Required for Google/GitHub sign-in and Supabase Realtime. The anon key is
# safe to expose in Vite; database access is enforced by RLS and the user's JWT.
#
# Setting VITE_SUPABASE_URL moves the feed off the gateway's SSE stream and onto
# Supabase tables, so the gateway must be writing there too (SUPABASE_URL +
# SUPABASE_SERVICE_ROLE_KEY in backend/.env) or the dashboard renders empty.
#
# The service role key must NEVER be put in a VITE_ variable — every VITE_
# value is compiled into the public browser bundle. It belongs in backend/.env.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Gateway base URL. Enables the SSE live feed and the kill switch
# (POST /v1/projects/suspend · /v1/projects/resume).
# VITE_API_URL=http://localhost:8000

# Agent key for the SSE lane's read-only feed (/v1/guard/status,
# /v1/events/recent, /v1/events/token). Local development only: every VITE_
# value is compiled into the public bundle, so treat anything here as published.
# Nothing is baked into the source — unset means the SSE feed says it is not
# authorized rather than silently using someone else's key.
# VITE_JUNO_KEY=

# Operator credential for the kill switch on a deployment with no Supabase to
# sign into. Must match OPERATOR_TOKEN in backend/.env. Suspend and resume
# refuse agent keys outright, so without this the kill switch is correctly
# unavailable rather than falling back to something weaker.
# With Supabase configured, leave this unset: the signed-in session is used and
# the gateway checks the caller's project role.
# VITE_JUNO_OPERATOR_TOKEN=
