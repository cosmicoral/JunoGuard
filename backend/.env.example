# Every credential below is optional. Missing values degrade to mock mode
# rather than failing to boot — the demo has to survive a dead dependency.

# --- Supabase ---------------------------------------------------------------
# Omit both to run on the in-memory store.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Ossprey ----------------------------------------------------------------
# Omit to use the deterministic mock: @ossprey/test-package is malicious,
# everything else is clean.
OSSPREY_API_KEY=
OSSPREY_BASE_URL=https://api.ossprey.com

# --- Sandbox detonation -----------------------------------------------------
# Build the pinned image first: docker build -t junoguard-sandbox:latest ../sandbox
# Keep disabled unless the gateway uses a dedicated/rootless Docker daemon.
SANDBOX_ENABLED=false
SANDBOX_IMAGE=junoguard-sandbox:latest
SANDBOX_DOCKER_BIN=docker
SANDBOX_TIMEOUT_SECONDS=12
SANDBOX_MAX_ARTIFACT_BYTES=10485760

# --- Model provider ---------------------------------------------------------
MOCK_PROVIDER=true
PROVIDER_API_KEY=
PROVIDER_MODEL=gpt-4o-mini
PROVIDER_BASE_URL=https://api.openai.com/v1

# --- Policy defaults --------------------------------------------------------
# Used by the in-memory store, and as a fallback when a project has no row.
DAILY_BUDGET_USD=1.00
PER_REQUEST_BUDGET_USD=0.05
MAX_REQUEST_TOKENS=4000
BURST_LIMIT_PER_MINUTE=8
BLOCK_SEVERITY=malicious
SUSPEND_ON_MALWARE=true

# --- Blast radius -----------------------------------------------------------
# The repository the agent is working in. Juno reads the NAMES of credentials
# declared in its .env files to compute reach. Values are never read, logged,
# or returned.
JUNO_SCAN_PATH=

DEMO_PROJECT_KEY=jg_demo_key_cursorhack2026
